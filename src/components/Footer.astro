---
import { NAV, type getSettings } from '../lib/site';

interface Props {
  settings: Awaited<ReturnType<typeof getSettings>>;
}

const { settings } = Astro.props;
const year = new Date().getFullYear();
// Footer columns follow the main menu: one column per dropdown, plus the
// single links gathered under "Explore".
const groups = [
  { label: 'Explore', links: NAV.filter((item) => !item.children) },
  ...NAV.filter((item) => item.children).map((item) => ({ label: item.label, links: item.children! })),
];
---

<footer class="site-footer">
  <div class="container grid">
    <div>
      <p class="name">{settings.programName}</p>
      <p>{settings.schoolName} {settings.mascot}<br />{settings.city}</p>
      <p>{settings.tagline}</p>
    </div>
    <nav class="links" aria-label="Footer">
      {
        groups.map((g) => (
          <div>
            <p class="label">{g.label}</p>
            <ul>
              {g.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
    <div>
      <p class="label">Contact</p>
      <p>
        {settings.contact.headCoach}<br />
        {
          settings.contact.email?.includes('@') ? (
            <a href={`mailto:${settings.contact.email}`}>{settings.contact.email}</a>
          ) : (
            settings.contact.email
          )
        }
      </p>
      {
        settings.social.length > 0 && (
          <ul class="social">
            {settings.social.map((s) => (
              <li>
                <a href={s.url} rel="noopener">{s.label}</a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
  <div class="container legal">
    <p>&copy; {year} {settings.schoolName} Baseball. <a href="/calendar.ics">Team calendar feed</a></p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: #e9e4e5;
    padding-top: 40px;
    font-size: 0.95rem;
  }

  .site-footer a {
    color: #fff;
    text-decoration: none;
  }

  .site-footer a:hover {
    text-decoration: underline;
    text-decoration-color: var(--maroon-tint);
  }

  .grid {
    display: grid;
    gap: 28px;
    grid-template-columns: 1fr;
  }

  @media (min-width: 720px) {
    .grid {
      grid-template-columns: 1fr 2.4fr;
    }

    .grid > :last-child {
      grid-column: 2;
    }
  }

  @media (min-width: 1000px) {
    .grid {
      grid-template-columns: 1.45fr 4fr 1.35fr;
    }

    .grid > :last-child {
      grid-column: auto;
    }
  }

  .links {
    display: grid;
    gap: 24px;
    grid-template-columns: repeat(2, 1fr);
  }

  @media (min-width: 720px) {
    .links {
      grid-template-columns: repeat(4, auto);
      justify-content: space-between;
    }
  }

  .name {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 1.125rem;
    color: #fff;
    margin-bottom: 8px;
  }

  .label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: var(--label-tracking);
    text-transform: uppercase;
    color: #bdb6b8;
    margin-bottom: 10px;
  }

  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav li,
  .social li {
    margin-bottom: 6px;
  }

  .social {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .legal {
    border-top: 1px solid rgb(255 255 255 / 0.12);
    margin-top: 28px;
    padding-block: 16px 24px;
    color: #bdb6b8;
    font-size: 0.875rem;
  }

  .legal p {
    margin: 0;
  }
</style>
