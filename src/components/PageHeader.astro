---
interface Props {
  title: string;
  intro?: string;
}
const { title, intro } = Astro.props;
---

<div class="page-header">
  <div class="container">
    <h1>{title}</h1>
    {intro && <p class="intro">{intro}</p>}
    <slot />
  </div>
</div>

<style>
  .page-header {
    background: linear-gradient(180deg, var(--maroon) 0%, var(--maroon-dark) 100%);
    color: var(--white);
    padding-block: clamp(28px, 6vw, 52px);
  }

  h1 {
    margin: 0;
  }

  .intro {
    margin: 10px 0 0;
    max-width: 60ch;
    font-size: 1.1rem;
    opacity: 0.92;
  }
</style>
