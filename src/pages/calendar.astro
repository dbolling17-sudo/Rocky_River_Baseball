---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import EventItem from '../components/EventItem.astro';
import { TYPE_GROUPS, getEvents, groupByMonth } from '../lib/events';

const events = await getEvents();
const months = groupByMonth(events);
---

<Base
  title="Schedule & Results"
  description="Rocky River baseball calendar: offseason workouts, team activities, games and results."
>
  <PageHeader
    title="Schedule & Results"
    intro="Workouts, team activities, games and results, month by month. Add the calendar to your phone and changes show up automatically."
  >
    <div class="actions no-print">
      <a class="btn btn-light" href="/calendar.ics" data-subscribe>Add to my calendar</a>
      <button class="btn btn-outline light" type="button" data-print>Print this month</button>
    </div>
  </PageHeader>

  <div class="container section">
    {
      months.length === 0 ? (
        <p class="card empty">The calendar will be posted soon.</p>
      ) : (
        <>
          <div class="toolbar no-print">
          <div class="filters" role="group" aria-label="Show">
            <button type="button" class="chip" aria-pressed="true" data-filter="all">
              All
            </button>
            {TYPE_GROUPS.map((g) => (
              <button type="button" class="chip" aria-pressed="false" data-filter={g.key}>
                {g.label}
              </button>
            ))}
          </div>

          {/* One month at a time once JavaScript runs; without it, every month is listed. */}
          <nav class="pager no-print" aria-label="Choose a month" hidden>
            <button type="button" class="step" data-step="-1" aria-label="Previous month">
              <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M11 3 5 9l6 6" fill="none" stroke="currentColor" stroke-width="2.2" /></svg>
            </button>
            <label class="visually-hidden" for="month-pick">Month</label>
            <select id="month-pick">
              {months.map((m) => (
                <option value={m.key}>{m.label}</option>
              ))}
            </select>
            <button type="button" class="step" data-step="1" aria-label="Next month">
              <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="m7 3 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" /></svg>
            </button>
          </nav>
          </div>

          {months.map((m) => (
            <section class="month" id={`m-${m.key}`} data-month={m.key} aria-labelledby={`h-${m.key}`}>
              <h2 id={`h-${m.key}`}>{m.label}</h2>
              <ul class="card list">
                {m.items.map((e) => (
                  <EventItem event={e} />
                ))}
              </ul>
              <p class="none-shown muted" hidden>
                Nothing of this kind this month.
              </p>
            </section>
          ))}
        </>
      )
    }
  </div>
</Base>

<script>
  // Dim events that have already happened, using today's date on the visitor's device.
  const today = new Date().toLocaleDateString('en-CA'); // YYYY-MM-DD
  document.querySelectorAll<HTMLElement>('.event').forEach((el) => {
    if ((el.dataset.date ?? '') < today) el.classList.add('is-past');
  });

  // Show one month at a time: this month (or the next one with events) unless
  // the address names a month, e.g. /calendar/#m-2027-03.
  const monthEls = [...document.querySelectorAll<HTMLElement>('.month')];
  const keys = monthEls.map((m) => m.dataset.month!);
  const pager = document.querySelector<HTMLElement>('.pager');
  const pick = document.querySelector<HTMLSelectElement>('#month-pick');
  const thisMonth = today.slice(0, 7);

  function showMonth(key: string, updateHash = false) {
    monthEls.forEach((m) => (m.hidden = m.dataset.month !== key));
    if (pick) pick.value = key;
    const i = keys.indexOf(key);
    pager?.querySelector<HTMLButtonElement>('[data-step="-1"]')!.toggleAttribute('disabled', i <= 0);
    pager?.querySelector<HTMLButtonElement>('[data-step="1"]')!.toggleAttribute('disabled', i >= keys.length - 1);
    if (updateHash) history.replaceState(null, '', `#m-${key}`);
  }

  if (pager && pick && keys.length > 1) {
    pager.hidden = false;
    const fromHash = location.hash.replace('#m-', '');
    const start = keys.includes(fromHash) ? fromHash : (keys.find((k) => k >= thisMonth) ?? keys[keys.length - 1]);
    showMonth(start);
    pick.addEventListener('change', () => showMonth(pick.value, true));
    pager.querySelectorAll<HTMLButtonElement>('.step').forEach((b) =>
      b.addEventListener('click', () => {
        const next = keys[keys.indexOf(pick.value) + Number(b.dataset.step)];
        if (next) showMonth(next, true);
      }),
    );
  }

  // Subscribe link: webcal:// opens the phone's calendar app and keeps it updated.
  const sub = document.querySelector<HTMLAnchorElement>('[data-subscribe]');
  if (sub && location.protocol === 'https:') sub.href = `webcal://${location.host}/calendar.ics`;

  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());

  // Filter buttons
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip')];
  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      const filter = chip.dataset.filter!;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      document.querySelectorAll<HTMLElement>('.month').forEach((month) => {
        let shown = 0;
        month.querySelectorAll<HTMLElement>('.event').forEach((el) => {
          const show = filter === 'all' || el.dataset.group === filter;
          el.hidden = !show;
          if (show) shown++;
        });
        month.querySelector<HTMLElement>('.list')!.hidden = shown === 0;
        month.querySelector<HTMLElement>('.none-shown')!.hidden = shown !== 0;
      });
    }),
  );
</script>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }

  .btn-outline.light {
    color: var(--white);
    border-color: rgb(255 255 255 / 0.6);
  }

  .btn-outline.light:hover {
    background: rgb(255 255 255 / 0.12);
    color: var(--white);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip {
    font: 600 0.9375rem var(--font-body);
    padding: 7px 15px;
    border-radius: 999px;
    border: 1.5px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
  }

  .chip[aria-pressed='true'] {
    background: var(--maroon);
    border-color: var(--maroon);
    color: var(--white);
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 20px;
  }

  .pager {
    display: inline-flex;
    align-items: stretch;
    border: 1.5px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    overflow: hidden;
  }

  .pager select {
    appearance: none;
    border: 0;
    border-inline: 1.5px solid var(--line);
    background: transparent;
    font: 600 1rem var(--font-body);
    color: var(--ink);
    padding: 8px 16px;
    text-align: center;
    text-align-last: center;
    min-width: 11rem;
    cursor: pointer;
  }

  .step {
    display: grid;
    place-items: center;
    width: 44px;
    border: 0;
    background: transparent;
    color: var(--maroon);
    cursor: pointer;
  }

  .step:hover:not([disabled]) {
    background: var(--maroon-tint);
  }

  .step[disabled] {
    color: var(--line);
    cursor: default;
  }

  .month {
    margin-top: 28px;
  }

  .month h2 {
    font-size: var(--step-2);
    padding-bottom: 8px;
    border-bottom: 2px solid var(--ink);
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
  }

  .empty {
    padding: 24px;
  }

  @media print {
    .month {
      break-inside: avoid;
    }
  }
</style>
