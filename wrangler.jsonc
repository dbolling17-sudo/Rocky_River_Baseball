// Cloudflare deploy settings. The site is plain static files: Cloudflare builds it
// with `npm run build` and serves the dist/ folder. Keep the domains listed here,
// or a deploy could detach them from the Worker.
{
  "name": "rocky-river-baseball",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "rrpiratesbaseball.com", "custom_domain": true },
    { "pattern": "www.rrpiratesbaseball.com", "custom_domain": true }
  ]
}
